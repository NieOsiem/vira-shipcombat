              <legend><label class="checkbox-label"><input type="checkbox" name="trait.shieldBypass" {{#if definition.traitState.shieldBypass}}checked{{/if}}> Shield bypass trait</label></legend>
              <div class="checkbox-inline-wrap">
                <label class="checkbox-label"><input type="checkbox" name="trait.shieldBypass.hull" {{#if definition.traitState.bypassHull}}checked{{/if}}> Hull bypasses shields</label>
                <label class="checkbox-label"><input type="checkbox" name="trait.shieldBypass.heat" {{#if definition.traitState.bypassHeat}}checked{{/if}}> Heat bypasses shields</label>
                <label class="checkbox-label"><input type="checkbox" name="trait.shieldBypass.damageShield" {{#if definition.traitState.damageShield}}checked{{/if}}> Also damage shields</label>
              </div>
            </fieldset>

            {{!-- Barrage Group --}}
            <fieldset class="trait-expandable-box" data-feature="trait.barrage" data-feature-label="Barrage" {{#unless definition.traitState.barrage}}disabled title="Enable Barrage first"{{/unless}}>
              <legend><label class="checkbox-label"><input type="checkbox" name="trait.barrage" {{#if definition.traitState.barrage}}checked{{/if}}> Barrage fire trait</label></legend>
              <table class="form-tier-table">
                <thead><tr><th scope="col">Rounds</th><th scope="col">Attack penalty</th><th scope="col">Max effective hits</th><th scope="col"></th></tr></thead>
                <tbody>
                  {{#each definition.barrageProfiles as |profile|}}
                    <tr data-barrage-row>
                      <td><input type="number" min="1" step="1" data-barrage-field="rounds" value="{{profile.rounds}}" aria-label="Rounds"></td>
                      <td><input type="number" step="any" data-barrage-field="attackPenalty" value="{{profile.attackPenalty}}" aria-label="Attack penalty"></td>
                      <td><input type="number" min="1" step="1" data-barrage-field="maxEffectiveHits" value="{{profile.maxEffectiveHits}}" aria-label="Maximum effective hits"></td>
                      <td><button class="ship-component-remove" type="button" data-row-action="remove-barrage" data-index="{{profile.index}}" aria-label="Remove barrage profile"><i class="fa-solid fa-trash" aria-hidden="true"></i></button></td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
              <button class="btn-add-row" type="button" data-row-action="add-barrage"><i class="fa-solid fa-plus" aria-hidden="true"></i> Add barrage profile</button>
            </fieldset>
          </div>

          {{!-- Visual Styling --}}
          <div class="form-card">
            <div class="form-card-header"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Visual Styling</div>
            <div class="form-grid-3">
              <label>Visual style
                <select name="definition.visualStyle">
                  {{#each visualStyleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                </select>
              </label>
              <label>Core color
                <input type="color" name="definition.coreColor" value="{{#if definition.coreColor}}{{definition.coreColor}}{{else}}#ffffff{{/if}}">
              </label>
              <label>Glow color
                <input type="color" name="definition.glowColor" value="{{#if definition.glowColor}}{{definition.glowColor}}{{else}}#ffaa00{{/if}}">
              </label>
            </div>
          </div>

          {{!-- Modes & Overclock --}}
          <div class="form-card">
            <div class="form-card-header"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Overclock Mode Configuration</div>
            <fieldset class="trait-expandable-box" data-feature="mode.overclock.enabled" data-feature-label="Overclock" {{#unless definition.hasOverclock}}disabled title="Enable Overclock first"{{/unless}}>
              <legend><label class="checkbox-label"><input type="checkbox" name="mode.overclock.enabled" {{#if definition.hasOverclock}}checked{{/if}}> Enable Overclock Mode</label></legend>
              <div class="form-grid-2">
                <label>Power rating override <input type="number" min="0" step="any" name="mode.overclock.powerRating" value="{{definition.overclock.powerRating}}"></label>
                <label>Accuracy override <input type="number" step="any" name="mode.overclock.accuracy" value="{{definition.overclock.accuracy}}"></label>
              </div>
              <div class="sub-form-group">
                <span class="field-label">Damage Overrides</span>
                <div class="form-grid-3">
                  <label>Shield <input type="number" min="0" step="any" name="mode.overclock.damage.shield" value="{{definition.overclock.damage.shield}}"></label>
                  <label>Hull <input type="number" min="0" step="any" name="mode.overclock.damage.hull" value="{{definition.overclock.damage.hull}}"></label>
                  <label>Heat <input type="number" min="0" step="any" name="mode.overclock.damage.heat" value="{{definition.overclock.damage.heat}}"></label>
                </div>
              </div>
              <div class="sub-form-group">
                <span class="field-label">Firing Heat Override</span>
                <div class="form-grid-2">
                  <label>Amount <input type="number" min="0" step="any" name="mode.overclock.firingHeat.amount" value="{{definition.overclock.firingHeat.amount}}"></label>
                  <label>Per interval
                    <select name="mode.overclock.firingHeat.per">
                      <option value=""></option>
                      {{#each overclockFiringHeatOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
                    </select>
                  </label>
                </div>
              </div>
            </fieldset>
          </div>
        {{/if}}

      </div>
    {{/if}}

  </section>

  {{!-- Sticky Save Button (Edit Mode Only) --}}
  {{#if isEditMode}}
    <footer class="ship-component-actions">
      <button class="ship-component-save" type="submit">
        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i> Save component
      </button>
    </footer>
  {{/if}}
</div>
