<div class="ship-component-editor {{#if isEditMode}}mode-edit{{else}}mode-play{{/if}}" data-component-form data-component-class="{{system.componentClass}}">
  {{#if denial}}<p class="ship-component-denial" role="status"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{denial}}</p>{{/if}}

  {{!-- Sheet Header --}}
  <header class="ship-component-header">
    {{!-- Image with FilePicker trigger --}}
    <button type="button" class="header-image-box {{#if isEditMode}}editable{{/if}}"
         data-action="{{#if isEditMode}}editImage{{else}}showIcon{{/if}}"
         title="{{#if isEditMode}}Click to choose artwork{{else}}Click to view artwork{{/if}}">
      <img class="ship-component-portrait" src="{{img}}" alt="{{name}}">
      {{#if isEditMode}}
        <div class="image-edit-overlay"><i class="fa-solid fa-camera" aria-hidden="true"></i></div>
      {{/if}}
    </button>
    <input type="hidden" name="img" value="{{img}}">

    {{!-- Name & Subtitles --}}
    <div class="header-identity">
      {{#if isEditMode}}
        <div class="name-edit-wrap">
          <input class="ship-component-name-input" type="text" name="name" value="{{name}}" placeholder="Component Name" autocomplete="off" required>
        </div>
        <div class="header-subtitles-edit">
          <label class="subtitle-field">
            <span class="field-label">Class</span>
            <select name="system.componentClass">
              {{#each componentClassOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          <label class="subtitle-field">
            <span class="field-label">Mount Size</span>
            <select name="system.size">
              {{#each sizeOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
          {{#if isDrive}}
            <label class="subtitle-field">
              <span class="field-label">Drive Role</span>
              <select name="system.driveRole">
                {{#each driveRoleOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </label>
          {{/if}}
          <label class="subtitle-field">
            <span class="field-label">Rarity</span>
            <select name="system.rarity">
              {{#each rarityOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
            </select>
          </label>
        </div>
      {{else}}
        <h1 class="ship-component-name">{{name}}</h1>
        <div class="header-subtitles-view">
          <span class="identity-badge class-badge"><i class="fa-solid fa-microchip" aria-hidden="true"></i> {{classLabel}}</span>
          <span class="identity-badge size-badge"><i class="fa-solid fa-ruler-combined" aria-hidden="true"></i> {{sizeLabel}}</span>
          {{#if driveRoleLabel}}<span class="identity-badge role-badge"><i class="fa-solid fa-angles-right" aria-hidden="true"></i> {{driveRoleLabel}}</span>{{/if}}
          {{#if rarityLabel}}<span class="identity-badge rarity-badge {{system.rarity}}">{{rarityLabel}}</span>{{/if}}
        </div>
      {{/if}}
    </div>

    {{!-- Physical Stats (Price, Weight, Qty) & Mode Toggle --}}
    <div class="header-metrics">
      {{#if canEdit}}
        <button type="button" class="ship-component-mode-btn {{#if isEditMode}}active{{/if}}" data-action="toggleMode" title="{{#if isEditMode}}Switch to View Mode{{else}}Switch to Edit Mode{{/if}}">
          <i class="fa-solid {{#if isEditMode}}fa-eye{{else}}fa-pen-to-square{{/if}}" aria-hidden="true"></i>
          <span>{{#if isEditMode}}View Mode{{else}}Edit Mode{{/if}}</span>
        </button>
      {{/if}}
      <div class="header-physical-fields">
        {{#if isEditMode}}
          <div class="physical-field-row">
            <label class="physical-label">Price</label>
            <div class="physical-input-pair">
              <input type="number" min="0" step="1" name="system.price.value" value="{{system.price.value}}" placeholder="0">
              <select name="system.price.denomination">
                {{#each currencyOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
          </div>
          <div class="physical-field-row">
            <label class="physical-label">Weight</label>
            <div class="physical-input-pair">
              <input type="number" min="0" step="any" name="system.weight.value" value="{{system.weight.value}}" placeholder="0">
              <select name="system.weight.units">
                {{#each weightUnitOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
              </select>
            </div>
          </div>
          <div class="physical-field-row">
            <label class="physical-label">Quantity</label>
            <input type="number" min="0" step="1" name="system.quantity" value="{{system.quantity}}" placeholder="1">
          </div>
        {{else}}
          <div class="physical-view-pill" title="Price">
            <i class="fa-solid fa-coins" aria-hidden="true"></i>
            <span class="value">{{priceFormatted}}</span>
          </div>
          <div class="physical-view-pill" title="Weight">
            <i class="fa-solid fa-weight-hanging" aria-hidden="true"></i>
            <span class="value">{{weightFormatted}}</span>
          </div>
          {{#if (gt system.quantity 1)}}
            <div class="physical-view-pill" title="Quantity">
              <span class="quantity-badge">&times;{{system.quantity}}</span>
            </div>
          {{/if}}
        {{/if}}
      </div>
    </div>
  </header>

  {{!-- Navigation Tabs --}}
  <nav class="sheet-tabs tabs" aria-label="Component Navigation">
    <button type="button" class="tab-btn {{#if isTabDescription}}active{{/if}}" data-action="tab" data-group="primary" data-tab="description">
      <i class="fa-solid fa-book-open" aria-hidden="true"></i> <span>Description</span>
    </button>
    <button type="button" class="tab-btn {{#if isTabProfile}}active{{/if}}" data-action="tab" data-group="primary" data-tab="profile">
      <i class="fa-solid fa-sliders" aria-hidden="true"></i> <span>Technical Profile</span>
    </button>
  </nav>

  {{!-- ================================================================ --}}
  {{!-- TAB 1: DESCRIPTION                                               --}}
  {{!-- ================================================================ --}}
  <section class="tab-content tab-description tab {{#if isTabDescription}}active{{/if}}" data-group="primary" data-tab="description">
    {{#if isEditMode}}
      <div class="description-edit-container">
        <label class="field-section-title"><i class="fa-solid fa-pen-nib" aria-hidden="true"></i> Item Description & Lore</label>
        <prose-mirror name="system.description.value" value="{{system.description.value}}" document-uuid="{{item.uuid}}" class="sized" compact>
          {{{enrichedDescription}}}
        </prose-mirror>
      </div>
    {{else}}
      <div class="description-view-container">
        {{!-- Quick specs bar for shop and overview --}}
        <div class="description-quick-specs">
          <div class="quick-spec-item"><span class="label">Class:</span> <span class="val">{{classLabel}}</span></div>
          <div class="quick-spec-item"><span class="label">Mount Size:</span> <span class="val">{{sizeLabel}}</span></div>
          {{#if isWeapon}}
            <div class="quick-spec-item"><span class="label">Optimal Range:</span> <span class="val">{{definition.range.optimal}} hex</span></div>
            <div class="quick-spec-item"><span class="label">Damage:</span> <span class="val">{{definition.damage.shield}} S / {{definition.damage.hull}} H</span></div>
          {{/if}}
          {{#if isReactor}}
            <div class="quick-spec-item"><span class="label">Nominal Output:</span> <span class="val">{{definition.nominalOutput}} MW</span></div>
          {{/if}}
          {{#if isShield}}
            <div class="quick-spec-item"><span class="label">Topology:</span> <span class="val">{{definition.topology}}</span></div>
            <div class="quick-spec-item"><span class="label">Budget:</span> <span class="val">{{definition.totalBudget}} SP</span></div>
          {{/if}}
          {{#if isDrive}}
            <div class="quick-spec-item"><span class="label">Base Thrust:</span> <span class="val">{{definition.base.thrust}}</span></div>
          {{/if}}
        </div>

        {{#if enrichedDescription}}
          <div class="editor-content prose-content">
            {{{enrichedDescription}}}
          </div>
        {{else}}
          <div class="empty-notice">
            <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
            <p>No operational description or catalog lore provided for this component.</p>
          </div>
        {{/if}}
      </div>
    {{/if}}
  </section>

  {{!-- ================================================================ --}}
  {{!-- TAB 2: TECHNICAL PROFILE                                         --}}
  {{!-- ================================================================ --}}
  <section class="tab-content tab-profile tab {{#if isTabProfile}}active{{/if}}" data-group="primary" data-tab="profile">

    {{#if isPlayMode}}
      {{!-- -------------------------------------------------------------- --}}
      {{!-- VIEW MODE: SCI-FI HUD SPEC CARDS                               --}}
      {{!-- -------------------------------------------------------------- --}}
      <div class="hud-profile-grid">

        {{#if isWeapon}}
          {{!-- Damage Profile Card --}}
          <div class="hud-card damage-card">
            <div class="hud-card-header"><i class="fa-solid fa-burst" aria-hidden="true"></i> Damage Output</div>
            <div class="hud-damage-metrics">
              <div class="hud-damage-chip shield" title="Damage dealt to active shields">
                <span class="chip-val">{{definition.damage.shield}}</span>
                <span class="chip-lbl">Shield</span>
              </div>
              <div class="hud-damage-chip hull" title="Damage dealt to vessel hull">
                <span class="chip-val">{{definition.damage.hull}}</span>
                <span class="chip-lbl">Hull</span>
              </div>
              <div class="hud-damage-chip heat" title="Heat transferred on hit">
                <span class="chip-val">{{definition.damage.heat}}</span>
                <span class="chip-lbl">Heat</span>
              </div>
            </div>
          </div>

          {{!-- Range & Firing Arc Card --}}
          <div class="hud-card range-card">
            <div class="hud-card-header"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i> Targeting & Envelope</div>
            <div class="hud-stat-grid">
              <div class="hud-stat"><span class="stat-label">Optimal Range</span><span class="stat-value">{{definition.range.optimal}} <small>hex</small></span></div>
              <div class="hud-stat"><span class="stat-label">Maximum Range</span><span class="stat-value">{{definition.range.maximum}} <small>hex</small></span></div>
              <div class="hud-stat"><span class="stat-label">Firing Arc</span><span class="stat-value">{{definition.arc}}&deg;</span></div>
              <div class="hud-stat"><span class="stat-label">Projectile Class</span><span class="stat-value capitalize">{{definition.projectileClass}}</span></div>
            </div>
          </div>

          {{!-- Combat Characteristics Card --}}
          <div class="hud-card combat-card">
            <div class="hud-card-header"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Combat Specifications</div>
            <div class="hud-stat-grid">
              <div class="hud-stat"><span class="stat-label">Accuracy Modifier</span><span class="stat-value">{{accuracyFormatted}}</span></div>
              <div class="hud-stat"><span class="stat-label">Armor Piercing</span><span class="stat-value">{{definition.armorPiercing}}</span></div>
              <div class="hud-stat"><span class="stat-label">Power Rating</span><span class="stat-value">{{definition.powerRating}} <small>MW</small></span></div>
              <div class="hud-stat"><span class="stat-label">Boot Time</span><span class="stat-value">{{definition.bootTime}} <small>rnd</small></span></div>
              <div class="hud-stat"><span class="stat-label">Signature Spike</span><span class="stat-value">{{signatureFormatted}}</span></div>
              <div class="hud-stat"><span class="stat-label">Recovery Work</span><span class="stat-value">{{definition.recoveryWork}} <small>work</small></span></div>
            </div>
          </div>

          {{!-- Readiness & Thermal Card --}}
          <div class="hud-card readiness-card">
            <div class="hud-card-header"><i class="fa-solid fa-fire" aria-hidden="true"></i> Readiness & Cycling</div>
            <div class="hud-stat-grid">
              <div class="hud-stat"><span class="stat-label">Firing Heat</span><span class="stat-value">{{definition.firingHeat.amount}} <small>/ {{definition.firingHeat.per}}</small></span></div>
              <div class="hud-stat"><span class="stat-label">Readiness Type</span><span class="stat-value capitalize">{{definition.readiness.type}}</span></div>
              <div class="hud-stat"><span class="stat-label">Magazine / Capacity</span><span class="stat-value">{{definition.readiness.capacity}}</span></div>
              <div class="hud-stat"><span class="stat-label">Recovery Method</span><span class="stat-value capitalize">{{definition.readiness.recovery}}</span></div>
              {{#if definition.readiness.work}}
                <div class="hud-stat"><span class="stat-label">Manual Work</span><span class="stat-value">{{definition.readiness.work}}</span></div>
              {{/if}}
              {{#if definition.readiness.eligibleStarts}}
                <div class="hud-stat"><span class="stat-label">Eligible Starts</span><span class="stat-value">{{definition.readiness.eligibleStarts}}</span></div>
              {{/if}}
            </div>
          </div>

          {{!-- Weapon Traits Card --}}
          <div class="hud-card traits-card">
            <div class="hud-card-header"><i class="fa-solid fa-tag" aria-hidden="true"></i> Weapon Traits & Special Rules</div>
            {{#if weaponTraitsList.length}}
              <div class="hud-trait-pill-list">
                {{#each weaponTraitsList}}
                  <div class="hud-trait-pill">
                    <span class="trait-name">{{label}}</span>
                    <span class="trait-desc">{{desc}}</span>
                  </div>
                {{/each}}
              </div>
              {{#if definition.barrageProfiles.length}}
                <div class="hud-barrage-table-wrap">
                  <table class="hud-ladder-table">
                    <caption>Barrage Fire Profiles</caption>
                    <thead><tr><th scope="col">Rounds</th><th scope="col">Attack Penalty</th><th scope="col">Max Effective Hits</th></tr></thead>
                    <tbody>
                      {{#each definition.barrageProfiles}}
                        <tr>
                          <td><strong>{{rounds}}</strong></td>
                          <td>{{attackPenalty}}</td>
                          <td>{{maxEffectiveHits}}</td>
                        </tr>
                      {{/each}}
                    </tbody>
                  </table>
                </div>
              {{/if}}
            {{else}}
              <p class="hud-empty-text">No special weapon traits configured.</p>
            {{/if}}
          </div>

          {{!-- Visual Styling --}}
          <div class="hud-card fx-card">
            <div class="hud-card-header"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Visual Styling</div>
            <div class="hud-card-body">
              <div class="hud-stat"><span class="stat-label">Effect Style</span><span class="stat-value capitalize">{{definition.visualStyle}}</span></div>
              <div class="hud-stat"><span class="stat-label">Core Color</span><span class="stat-value"><span class="color-chip" style="background:{{definition.coreColor}}"></span> {{definition.coreColor}}</span></div>
              <div class="hud-stat"><span class="stat-label">Glow Color</span><span class="stat-value"><span class="color-chip" style="background:{{definition.glowColor}}"></span> {{definition.glowColor}}</span></div>
            </div>
          </div>

          {{!-- Overclock Mode Card --}}
          {{#if definition.hasOverclock}}
            <div class="hud-card overclock-card">
              <div class="hud-card-header overclock"><i class="fa-solid fa-bolt" aria-hidden="true"></i> Overclock Mode Overrides</div>
              <div class="hud-stat-grid">
                {{#if definition.overclock.powerRating}}
                  <div class="hud-stat"><span class="stat-label">Power Rating</span><span class="stat-value">{{definition.overclock.powerRating}} <small>MW</small></span></div>
                {{/if}}
                {{#if definition.overclock.accuracy}}
                  <div class="hud-stat"><span class="stat-label">Accuracy Override</span><span class="stat-value">{{definition.overclock.accuracy}}</span></div>
                {{/if}}
                {{#if definition.overclock.firingHeat.amount}}
                  <div class="hud-stat"><span class="stat-label">Firing Heat</span><span class="stat-value">{{definition.overclock.firingHeat.amount}} <small>/ {{definition.overclock.firingHeat.per}}</small></span></div>
                {{/if}}
                {{#if definition.overclock.damage}}
                  <div class="hud-stat full-width">
                    <span class="stat-label">Damage Overrides</span>
                    <span class="stat-value">
                      {{#if definition.overclock.damage.shield}}Shield {{definition.overclock.damage.shield}} &nbsp;{{/if}}
                      {{#if definition.overclock.damage.hull}}Hull {{definition.overclock.damage.hull}} &nbsp;{{/if}}
                      {{#if definition.overclock.damage.heat}}Heat {{definition.overclock.damage.heat}}{{/if}}
                    </span>
                  </div>
                {{/if}}
              </div>
            </div>
          {{/if}}
        {{/if}}

        {{#if isReactor}}
          <div class="hud-card">
            <div class="hud-card-header"><i class="fa-solid fa-atom" aria-hidden="true"></i> Reactor Power Output</div>
            <div class="hud-stat-grid">
              <div class="hud-stat highlight"><span class="stat-label">Nominal Output</span><span class="stat-value">{{definition.nominalOutput}} <small>MW</small></span></div>
              <div class="hud-stat highlight amber"><span class="stat-label">Redline Output</span><span class="stat-value">{{definition.redlineOutput}} <small>MW</small></span></div>
              <div class="hud-stat"><span class="stat-label">Redline Overclock Heat</span><span class="stat-value">{{definition.overclockHeat}} <small>Heat</small></span></div>
              <div class="hud-stat"><span class="stat-label">Recovery Work</span><span class="stat-value">{{definition.recoveryWork}} <small>Work</small></span></div>
            </div>
            {{#if definition.dirtyCore}}
              <div class="hud-trait-pill alert" style="margin-top: 8px;">
                <span class="trait-name"><i class="fa-solid fa-triangle-exclamation"></i> Dirty Core</span>
                <span class="trait-desc">Risks reactor instability each End Phase</span>
              </div>
            {{/if}}
          </div>
        {{/if}}

        {{#if isDrive}}
          <div class="hud-card">
            <div class="hud-card-header"><i class="fa-solid fa-angles-right" aria-hidden="true"></i> Base Propulsion</div>
            <div class="hud-stat-grid">
              <div class="hud-stat highlight"><span class="stat-label">Base Thrust</span><span class="stat-value">{{definition.base.thrust}} <small>hex</small></span></div>
              <div class="hud-stat highlight"><span class="stat-label">Base Rotation</span><span class="stat-value">{{definition.base.rotation}}&deg;</span></div>
              <div class="hud-stat"><span class="stat-label">Recovery Work</span><span class="stat-value">{{definition.recoveryWork}} <small>Work</small></span></div>
            </div>
            {{#if definition.gasketBlowout}}
              <div class="hud-trait-pill alert" style="margin-top: 8px;">
                <span class="trait-name"><i class="fa-solid fa-triangle-exclamation"></i> Gasket Blowout</span>
                <span class="trait-desc">Risks drive failure when maintaining Overclock</span>
              </div>
            {{/if}}
          </div>
          <div class="hud-card full-width">
            <div class="hud-card-header"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Propulsion Power Tiers</div>
            <table class="hud-ladder-table">
              <thead><tr><th scope="col">Power (MW)</th><th scope="col">Thrust Multiplier</th><th scope="col">Online</th><th scope="col">Overclock</th><th scope="col">Heat</th></tr></thead>
              <tbody>
                {{#each definition.tiers}}
                  <tr class="{{#if overclock}}overclock-row{{/if}}">
                    <td><strong>{{power}} MW</strong></td>
                    <td>&times;{{multiplier}}</td>
                    <td>{{#if online}}<span class="status-badge on">Online</span>{{else}}<span class="status-badge off">Off</span>{{/if}}</td>
                    <td>{{#if overclock}}<span class="status-badge oc">Yes</span>{{else}}&mdash;{{/if}}</td>
                    <td>{{#if overclockHeat}}{{overclockHeat}} Heat{{else}}&mdash;{{/if}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{/if}}

        {{#if isShield}}
          <div class="hud-card">
            <div class="hud-card-header"><i class="fa-solid fa-shield-virus" aria-hidden="true"></i> Shield Architecture</div>
            <div class="hud-stat-grid">
              <div class="hud-stat highlight"><span class="stat-label">Topology</span><span class="stat-value capitalize">{{definition.topology}}</span></div>
              <div class="hud-stat highlight"><span class="stat-label">Total Shield Budget</span><span class="stat-value">{{definition.totalBudget}} <small>SP</small></span></div>
              <div class="hud-stat"><span class="stat-label">Sector Cap</span><span class="stat-value">{{#if isDirectionalShield}}{{definition.sectorCap}} <small>SP</small>{{else}}Single Bubble{{/if}}</span></div>
              <div class="hud-stat"><span class="stat-label">Recharge Delay</span><span class="stat-value">{{definition.rechargeDelay}} <small>rnd</small></span></div>
              <div class="hud-stat"><span class="stat-label">Recovery Work</span><span class="stat-value">{{definition.recoveryWork}} <small>Work</small></span></div>
            </div>
            {{#if definition.cascadingCollapse}}
              <div class="hud-trait-pill alert" style="margin-top: 8px;">
                <span class="trait-name"><i class="fa-solid fa-triangle-exclamation"></i> Cascading Collapse</span>
                <span class="trait-desc">When one sector falls, all sectors collapse</span>
              </div>
            {{/if}}
            {{#if definition.thermalBleedFraction}}
              <div class="hud-trait-pill alert" style="margin-top: 8px;">
                <span class="trait-name"><i class="fa-solid fa-fire"></i> Thermal Bleed</span>
                <span class="trait-desc">{{definition.thermalBleedFraction}} of absorbed damage becomes Heat</span>
              </div>
            {{/if}}
          </div>
          <div class="hud-card">
            <div class="hud-card-header"><i class="fa-solid fa-compass" aria-hidden="true"></i> Protected Sectors</div>
            <div class="hud-sectors-list">
              {{#if isDirectionalShield}}
                <span class="sector-badge"><i class="fa-solid fa-arrow-up"></i> Fore</span>
                <span class="sector-badge"><i class="fa-solid fa-arrow-left"></i> Port</span>
                <span class="sector-badge"><i class="fa-solid fa-arrow-right"></i> Starboard</span>
                <span class="sector-badge"><i class="fa-solid fa-arrow-down"></i> Aft</span>
              {{else}}
                <span class="sector-badge bubble"><i class="fa-solid fa-circle"></i> Omnidirectional Bubble</span>
              {{/if}}
            </div>
          </div>
          <div class="hud-card full-width">
            <div class="hud-card-header"><i class="fa-solid fa-layer-group" aria-hidden="true"></i> Shield Power Tiers</div>
            <table class="hud-ladder-table">
              <thead><tr><th scope="col">Power (MW)</th><th scope="col">Online</th><th scope="col">Regeneration</th><th scope="col">Overclock</th><th scope="col">Heat</th></tr></thead>
              <tbody>
                {{#each definition.tiers}}
                  <tr class="{{#if overclock}}overclock-row{{/if}}">
                    <td><strong>{{power}} MW</strong></td>
                    <td>{{#if online}}<span class="status-badge on">Online</span>{{else}}<span class="status-badge off">Off</span>{{/if}}</td>
                    <td>+{{regeneration}} SP / rnd</td>
                    <td>{{#if overclock}}<span class="status-badge oc">Yes</span>{{else}}&mdash;{{/if}}</td>
                    <td>{{#if overclockHeat}}{{overclockHeat}} Heat{{else}}&mdash;{{/if}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{/if}}

        {{#if isSensor}}
          <div class="hud-card">
            <div class="hud-card-header"><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i> Sensor Array Specifications</div>
            <div class="hud-stat-grid">
              <div class="hud-stat"><span class="stat-label">Passive Range</span><span class="stat-value">{{definition.base.passiveRange}} <small>hex</small></span></div>
              <div class="hud-stat"><span class="stat-label">Passive Strength</span><span class="stat-value">{{definition.base.passiveStrength}}</span></div>
              <div class="hud-stat"><span class="stat-label">Active Range</span><span class="stat-value">{{definition.base.activeRange}} <small>hex</small></span></div>
              <div class="hud-stat"><span class="stat-label">Active Modifier</span><span class="stat-value">{{definition.base.activeModifier}}</span></div>
              <div class="hud-stat"><span class="stat-label">EW Modifier</span><span class="stat-value">{{definition.base.ewModifier}}</span></div>
