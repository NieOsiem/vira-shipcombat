<section class="ship-console-layout" aria-label="Vira ship console">
  <header class="ship-console-header">
    <div class="ship-console-portrait"><img src="{{actor.img}}" alt=""></div>
    <div class="ship-console-heading">
      <div class="ship-console-title-row"><h1>{{actor.name}}</h1><span class="ship-phase{{#unless view.combat.inCombat}} ship-phase--outsideCombat{{/unless}}" data-phase-chip title="{{view.status.phaseLabel}}{{#if view.status.turnLabel}} · {{view.status.turnLabel}}{{/if}}">{{view.combat.label}}</span></div>
    </div>
    <section class="ship-status-strip" aria-label="Ship resources">
      <article class="ship-status-meter"><div><span>Hull</span><strong>{{view.status.hull.value}} / {{view.status.hull.maximum}}</strong></div><div class="ship-meter ship-meter--{{view.status.hull.tone}}" style="{{view.status.hull.style}}"><span></span></div></article>
      <article class="ship-status-meter"><div><span>Shields</span><strong>{{view.shields.total}} / {{view.shields.budget}}</strong></div><div class="ship-meter ship-meter--shield" style="{{view.shields.meter.style}}"><span></span></div></article>
      <article class="ship-status-meter"><div><span>Heat</span><strong>{{view.status.heat.value}} / {{view.status.heat.maximum}}</strong></div><div class="ship-meter ship-meter--{{view.status.heat.tone}}" style="{{view.status.heat.style}}"><span></span></div></article>
      <article class="ship-status-meter"><div><span>Reactor</span><strong>{{view.power.committed}} / {{view.power.nominalOutput}}</strong></div><div class="ship-meter ship-meter--{{view.power.meter.tone}}" style="{{view.power.meter.style}}"><span></span></div></article>
    </section>
  </header>

  {{#if unavailableReason}}<p class="ship-console-notice" role="status"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{unavailableReason}}</p>{{/if}}

  <div class="ship-console-navigation">
    <nav class="ship-console-tabs" role="tablist" aria-label="Combat sections">
      {{#each tabs}}<button type="button" role="tab" data-tab-button="{{id}}" aria-selected="{{active}}" tabindex="{{#if active}}0{{else}}-1{{/if}}" aria-controls="panel-{{id}}">{{label}}</button>{{/each}}
    </nav>
    {{#if isGM}}
    <details class="ship-maintenance-menu">
      <summary title="Maintenance and configuration" aria-label="Maintenance and configuration"><i class="fa-solid fa-ellipsis-vertical" aria-hidden="true"></i></summary>
      <nav aria-label="Maintenance sections">
        {{#each maintenanceTabs}}<button type="button" data-tab-button="{{id}}" aria-pressed="{{active}}" aria-controls="panel-{{id}}">{{label}}</button>{{/each}}
        <button type="button" data-native-vehicle-sheet><i class="fa-solid fa-file-shield" aria-hidden="true"></i> Vehicle configuration</button>
      </nav>
    </details>
    {{/if}}
  </div>

  <div class="ship-console-panels">
    <section id="panel-overview" class="ship-console-panel" role="tabpanel" aria-label="Overview" data-tab-panel="overview" {{#unless tabState.overview.active}}hidden{{/unless}}>
      <div class="ship-panel-heading"><h2>Overview</h2><span class="ship-readout">Signature {{view.status.signature.value}}</span></div>
      {{#if view.hasConditions}}<section class="ship-alert-stack" aria-label="Active conditions">{{#each view.conditions}}<div class="ship-alert ship-alert--{{severity}}"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i><strong>{{label}}</strong><span>{{severity}}{{#if sector}} · {{sector}}{{/if}}</span></div>{{/each}}</section>{{/if}}
      {{#each view.importantDamage}}<p class="ship-warning"><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> {{label}} · {{statusLabel}}{{#if componentLabel}} · {{componentLabel}}{{/if}}</p>{{/each}}
      <section class="ship-card ship-console-specifications" aria-label="Installed ship statistics">
        <div class="ship-console-specification-groups">{{#each specGroups}}<section><h3>{{label}}</h3><dl>{{#each entries}}<div><dt>{{label}}</dt><dd>{{value}}</dd></div>{{/each}}</dl></section>{{/each}}</div>
      </section>
      <section class="ship-card ship-overview-weapons" aria-label="Installed weapons">
        <header><h3>Weapons</h3></header>
        {{#each view.weapons}}<div><strong>{{label}}</strong><span>{{statusLabel}} · {{damage}} · AP {{armorPiercing}} · {{range}} / {{arc}}°</span></div>{{else}}<p class="ship-empty">No weapons installed.</p>{{/each}}
      </section>
    </section>

    <section id="panel-crew" class="ship-console-panel" role="tabpanel" aria-label="Crew" data-tab-panel="crew" {{#unless tabState.crew.active}}hidden{{/unless}}>
      <div class="ship-panel-heading">
        <h2>Crew</h2>
        <span class="ship-readout">{{view.crewOrders.shipWideOrders}} Orders · {{view.crewOrders.pendingCount}} tasks · {{view.stationSlots.occupied.command}}/{{view.stationSlots.capacity.command}} command · {{view.stationSlots.occupied.crew}}/{{view.stationSlots.capacity.crew}} crew seated</span>
      </div>
      <p class="ship-flow-hint">Orders are spent by the seated crew. Everything they can be ordered to do right now is listed first; who is seated is at the bottom of the tab.</p>

      {{#if rosterConflicts.length}}<section class="ship-card ship-roster-conflicts" role="alert" aria-label="Roster conflicts"><header><h3><i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Station conflicts</h3></header><ul>{{#each rosterConflicts}}<li><strong>{{tokens}}</strong><span>{{slots}}</span></li>{{/each}}</ul><p class="ship-muted">An identity bound to more than one station of this ship is reported here; the engine does not block combat on it.</p></section>{{/if}}

      <section class="ship-card ship-crew-orders-board" aria-label="Support Crew Orders">
        <header>
          <div>
            <span class="ship-kicker">Support Operations</span>
            <h3>Support Crew Orders</h3>
          </div>
          <span class="ship-status-chip {{#if view.crewOrders.shipWideOrders}}ship-status-chip--nominal{{else}}ship-status-chip--off{{/if}}" title="Orders remaining across every operator of this ship, not only your own.">
            {{view.crewOrders.shipWideOrders}} ship-wide Orders
          </span>
        </header>
        <p class="ship-muted">Each task spends one Order, and the list reads top-down by what the fight usually needs first: a hull about to breach, a wrecked system, a degraded one, ordnance, then heat.</p>

        {{#if view.crewOrders.jobs.length}}
          <div class="ship-crew-jobs-list">
            {{#each view.crewOrders.jobs}}
              <div class="ship-crew-job-row ship-crew-job-row--{{tone}}">
                <span class="ship-crew-job-kind">{{kindLabel}}</span>
                <div class="ship-crew-job-info">
                  <strong>{{label}}</strong>
                  <small class="ship-muted">{{detail}}{{#if ../view.crewOrders.hasActingOperator}} · {{costDetail}}{{else}} · no operator can spend this Order{{/if}}</small>
                </div>
                <form data-ui-operation="{{type}}" class="ship-crew-job-form">
                  <input type="hidden" name="operatorId" value="{{../view.crewOrders.defaultOperatorId}}">
                  {{#if conditionId}}<input type="hidden" name="conditionId" value="{{conditionId}}"><input type="hidden" name="rating" value="engineering">{{/if}}
                  {{#if weaponId}}<input type="hidden" name="weaponId" value="{{weaponId}}">{{/if}}
                  <button type="submit" class="ship-crew-job-btn" title="{{#unless ../view.crewOrders.hasActingOperator}}No acting operator — assign a character to a Crew station first.{{else}}{{#unless ../canAct}}{{../actReason}}{{else}}{{actionLabel}} — {{costDetail}}{{/unless}}{{/unless}}" {{#unless ../view.crewOrders.hasActingOperator}}disabled{{else}}{{#unless ../canAct}}disabled{{/unless}}{{/unless}}>
                    <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> {{actionLabel}}
                  </button>
                </form>
              </div>
            {{/each}}
          </div>
        {{else}}
          <p class="ship-empty" style="margin-top: 0.35rem;"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> All systems nominal. No pending support crew tasks.</p>
        {{/if}}
      </section>

      <details class="ship-card ship-stations">
        <summary>
          <span class="ship-kicker">Stations</span>
          <strong>{{view.stationSlots.occupied.command}}/{{view.stationSlots.capacity.command}} command · {{view.stationSlots.occupied.crew}}/{{view.stationSlots.capacity.crew}} crew</strong>
          <span class="ship-stations-roster">{{#each view.stationSlots.seats}}<span class="ship-station-seat{{#unless occupied}} ship-station-seat--empty{{/unless}}{{#if mine}} ship-station-seat--mine{{/if}}" title="{{label}}{{#if occupied}} · {{operatorLabel}} · {{remaining}} {{resource}} remaining{{/if}}"><b>{{key}}</b>{{#if occupied}}{{operatorLabel}} <i>{{remaining}}</i>{{else}}vacant{{/if}}</span>{{/each}}</span>
        </summary>

      <div class="ship-crew-section-heading">
        <h3>Command Stations (3 Actions)</h3>
        <small class="ship-muted">Active consoles for maneuvers, routing, targeting, and weapons</small>
      </div>
      <div class="ship-operator-grid">
        {{#each view.stationSlots.command}}
          {{#if occupied}}
            <form class="ship-card ship-operator-card" data-roster-slot data-kind="command" data-slot="{{slot}}">
              <header class="ship-operator-header">
                {{#if operator.img}}<img class="ship-operator-avatar" src="{{operator.img}}" alt="{{operator.label}}" data-roster-actor="{{operator.actorId}}" title="Click to open character sheet">{{/if}}
                <div class="ship-operator-title">
                  <span class="ship-kicker">{{label}} · {{operator.typeLabel}}</span>
                  <h3 class="ship-operator-name" data-roster-actor="{{operator.actorId}}" title="Click to open character sheet">{{operator.label}}</h3>
                </div>
                <strong>{{operator.remaining}} Actions</strong>
              </header>
              <input type="hidden" name="operatorId" value="{{operator.id}}">
              <dl class="ship-rating-grid">
                <div><dt>Pilot</dt><dd>{{operator.ratings.piloting}}</dd></div>
                <div><dt>Gunnery</dt><dd>{{operator.ratings.gunnery}}</dd></div>
                <div><dt>Sensors</dt><dd>{{operator.ratings.sensors}}</dd></div>
                <div><dt>Engineering</dt><dd>{{operator.ratings.engineering}}</dd></div>
              </dl>
              <p class="ship-muted">Controls: {{operator.controlsLabel}}</p>
              <div class="ship-segmented">
                <button type="button" data-ui-operation="takeControl" data-control="helm" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>Helm</button>
                <button type="button" data-ui-operation="takeControl" data-control="power" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>Power</button>
                <button type="button" data-ui-operation="takeControl" data-control="defense" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>Defense</button>
              </div>
              {{#if operator.heldControls.length}}
                <div class="ship-action-row ship-slot-actions ship-held-controls">
                  {{#each operator.heldControls}}
                    <button type="button" class="ship-slot-action-btn" data-release-control="{{this}}" data-operator-id="{{../operator.id}}" aria-label="Release {{this}} control held by {{../operator.label}}" {{#unless ../../canAct}}disabled title="{{../../actReason}}"{{/unless}}><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Release <span class="ship-control-name">{{this}}</span></button>
                  {{/each}}
                </div>
              {{/if}}
              <div class="ship-action-row ship-slot-actions">
                {{#if operator.actorId}}
                  <button type="button" class="ship-slot-action-btn" data-roster-edit="{{operator.actorId}}" title="Edit {{operator.label}}&#39;s station ratings"><i class="fa-solid fa-pen-to-square"></i> Ratings</button>
                {{else}}
                  <span class="ship-slot-action-btn ship-slot-action-btn--preset" title="Preset profiles have no character sheet to edit. Assign a world character to edit ratings.">Preset profile</span>
                {{/if}}
                {{#if ../isGM}}
                  <button type="button" class="ship-slot-action-btn ship-slot-action-btn--danger" data-roster-remove="command-{{slot}}" title="Unassign character"><i class="fa-solid fa-user-xmark"></i> Eject</button>
                {{/if}}
              </div>
            </form>
          {{else}}
            <article class="ship-card ship-operator-card ship-operator-card--empty" data-roster-slot data-kind="command" data-slot="{{slot}}">
              <div class="ship-slot-dropzone">
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                <div class="ship-slot-dropzone-text">
                  <span class="ship-kicker">{{label}} · Available</span>
                  <h4>Drop PC or NPC here</h4>
                </div>
              </div>
              {{#if canEdit}}
                <div class="ship-slot-picker">
                  <form data-assign-picker data-kind="{{kind}}" data-slot="{{slot}}" class="ship-slot-picker-form">
                    <select name="target">
                      <option value="">— Unassign —</option>
                      {{#each pickerGroups}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</optgroup>{{/each}}
                    </select>
                    <button type="submit" {{#unless ../canAdmin}}disabled title="{{../actReason}}"{{/unless}}>Assign</button>
                  </form>
                </div>
              {{else}}
                <p class="ship-slot-note ship-muted">A GM assigns stations. Ask your GM to place your character on {{label}}.</p>
              {{/if}}
            </article>
          {{/if}}
        {{else}}
          <p class="ship-empty">This hull has no Command Capacity.</p>
        {{/each}}
      </div>

      <div class="ship-crew-section-heading" style="margin-top: 1rem;">
        <h3>Crew Stations (1 Order)</h3>
        <small class="ship-muted">Support stations for repairs, reloads, sensors, and consoles</small>
      </div>
      <div class="ship-operator-grid">
        {{#each view.stationSlots.crew}}
          {{#if occupied}}
            <form class="ship-card ship-operator-card" data-roster-slot data-kind="crew" data-slot="{{slot}}">
              <header class="ship-operator-header">
                {{#if operator.img}}<img class="ship-operator-avatar" src="{{operator.img}}" alt="{{operator.label}}" data-roster-actor="{{operator.actorId}}" title="Click to open character sheet">{{/if}}
                <div class="ship-operator-title">
                  <span class="ship-kicker">{{label}} · {{operator.typeLabel}}</span>
                  <h3 class="ship-operator-name" data-roster-actor="{{operator.actorId}}" title="Click to open character sheet">{{operator.label}}</h3>
                </div>
                <strong>{{operator.remaining}} Orders</strong>
              </header>
              <input type="hidden" name="operatorId" value="{{operator.id}}">
              <dl class="ship-rating-grid">
                <div><dt>Pilot</dt><dd>{{operator.ratings.piloting}}</dd></div>
                <div><dt>Gunnery</dt><dd>{{operator.ratings.gunnery}}</dd></div>
                <div><dt>Sensors</dt><dd>{{operator.ratings.sensors}}</dd></div>
                <div><dt>Engineering</dt><dd>{{operator.ratings.engineering}}</dd></div>
              </dl>
              <p class="ship-muted">Crew Orders can repair, reload, scan, fire, contribute Work, or take a console.</p>
              {{#if operator.heldControls.length}}
                <div class="ship-action-row ship-slot-actions ship-held-controls">
                  {{#each operator.heldControls}}
                    <button type="button" class="ship-slot-action-btn" data-release-control="{{this}}" data-operator-id="{{../operator.id}}" aria-label="Release {{this}} control held by {{../operator.label}}" {{#unless ../../canAct}}disabled title="{{../../actReason}}"{{/unless}}><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Release <span class="ship-control-name">{{this}}</span></button>
                  {{/each}}
                </div>
              {{/if}}
              <div class="ship-action-row ship-slot-actions">
                {{#if operator.actorId}}
                  <button type="button" class="ship-slot-action-btn" data-roster-edit="{{operator.actorId}}" title="Edit {{operator.label}}&#39;s station ratings"><i class="fa-solid fa-pen-to-square"></i> Ratings</button>
                {{else}}
                  <span class="ship-slot-action-btn ship-slot-action-btn--preset" title="Preset profiles have no character sheet to edit. Assign a world character to edit ratings.">Preset profile</span>
                {{/if}}
                {{#if ../isGM}}
                  <button type="button" class="ship-slot-action-btn ship-slot-action-btn--danger" data-roster-remove="crew-{{slot}}" title="Unassign character"><i class="fa-solid fa-user-xmark"></i> Eject</button>
                {{/if}}
              </div>
            </form>
          {{else}}
            <article class="ship-card ship-operator-card ship-operator-card--empty" data-roster-slot data-kind="crew" data-slot="{{slot}}">
              <div class="ship-slot-dropzone">
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                <div class="ship-slot-dropzone-text">
                  <span class="ship-kicker">{{label}} · Available</span>
                  <h4>Drop PC or NPC here</h4>
                </div>
              </div>
              {{#if canEdit}}
                <div class="ship-slot-picker">
                  <form data-assign-picker data-kind="{{kind}}" data-slot="{{slot}}" class="ship-slot-picker-form">
                    <select name="target">
                      <option value="">— Unassign —</option>
                      {{#each pickerGroups}}<optgroup label="{{label}}">{{#each options}}<option value="{{value}}">{{label}}</option>{{/each}}</optgroup>{{/each}}
                    </select>
                    <button type="submit" {{#unless ../canAdmin}}disabled title="{{../actReason}}"{{/unless}}>Assign</button>
                  </form>
                </div>
              {{else}}
                <p class="ship-slot-note ship-muted">A GM assigns stations. Ask your GM to place your character on {{label}}.</p>
              {{/if}}
            </article>
          {{/if}}
        {{else}}
          <p class="ship-empty">This hull has no Crew Capacity.</p>
        {{/each}}
      </div>

      </details>
    </section>

    <section id="panel-helm" class="ship-console-panel" role="tabpanel" aria-label="Helm" data-tab-panel="helm" {{#unless tabState.helm.active}}hidden{{/unless}}>
      <div class="ship-panel-heading">
        <h2>Helm</h2>
        {{#if isGM}}
          <label class="ship-page-operator">Pilot<select name="operatorId" data-page-operator="helm" data-default="{{view.defaults.helm}}">{{#each view.operators}}<option value="{{id}}">{{label}} · Pilot {{ratings.piloting}} · {{remaining}} {{resource}}</option>{{/each}}</select></label>
        {{else}}
          <span class="ship-page-operator">Pilot <span class="ship-helm-holder-name">{{view.helmHolderLabel}}</span></span>
        {{/if}}
        <div class="ship-helm-actions-inline">
          <span class="ship-readout" title="Helm Station Status">{{#if view.helmHeld}}ACTIVE{{else}}VACANT{{/if}}</span>
          {{#if view.helmHeld}}
            <button type="button" class="ship-station-btn ship-station-btn--release" data-ui-operation="releaseControl" data-control="helm" data-operator-id="{{view.helmHolder}}" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i> Release Helm</button>
          {{else}}
            <button type="button" class="ship-station-btn ship-station-btn--take ship-primary" data-ui-operation="takeControl" data-control="helm" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-hand" aria-hidden="true"></i> Take Helm</button>
          {{/if}}
        </div>
      </div>

      <form class="ship-helm-body" data-ui-operation="maneuver" data-live-preview="maneuver">
        <input type="hidden" name="operatorId" value="{{view.defaults.helm}}">
        <fieldset class="ship-helm-controls" {{#unless view.helmHeld}}disabled{{/unless}}>

          <section class="ship-helm-axis" aria-label="Main thrust" style="--zero-position: {{view.movement.forwardZeroPosition}}%;">
            <div class="ship-helm-axis-header">
              <i class="fa-solid fa-up-long" aria-hidden="true"></i>
              <h3>Main Thrust</h3>
              <span class="ship-helm-budget" data-budget="translation">Trans budget: <span class="ship-budget-spent">{{view.movement.translationBudgetSpentPct}}% spent</span> · <span class="ship-budget-current" data-budget-current>0% current</span> · <span class="ship-budget-left">{{view.movement.translationBudgetLeftPct}}% left</span></span>
            </div>
            <output class="ship-helm-value-chip" data-slider-value="forward">0</output>
            <div class="ship-helm-slider-track" data-helm-track="forward" style="--zero-position: {{view.movement.forwardZeroPosition}}%; {{view.movement.forwardTrackStyle}}">
              <input name="forward" type="range" value="0" aria-label="Main thrust: retro to forward" style="{{view.movement.forwardTrackStyle}}">
            </div>
            <div class="ship-helm-slider-labels"><span>Retro {{view.movement.retroMax}}</span><span>0</span><span>Forward {{view.movement.forwardMax}}</span></div>
          </section>

          <section class="ship-helm-axis" aria-label="Lateral thrust" style="--zero-position: {{view.movement.lateralZeroPosition}}%;">
            <div class="ship-helm-axis-header">
              <i class="fa-solid fa-left-right" aria-hidden="true"></i>
              <h3>Lateral Thrust</h3>
              <span class="ship-helm-budget" data-budget="translation">Trans budget: <span class="ship-budget-spent">{{view.movement.translationBudgetSpentPct}}% spent</span> · <span class="ship-budget-current" data-budget-current>0% current</span> · <span class="ship-budget-left">{{view.movement.translationBudgetLeftPct}}% left</span></span>
            </div>
            <output class="ship-helm-value-chip" data-slider-value="lateral">0</output>
            <div class="ship-helm-slider-track" data-helm-track="lateral" style="--zero-position: {{view.movement.lateralZeroPosition}}%; {{view.movement.lateralTrackStyle}}">
              <input name="lateral" type="range" value="0" aria-label="Lateral thrust: port to starboard" style="{{view.movement.lateralTrackStyle}}">
            </div>
            <div class="ship-helm-slider-labels"><span>Port {{view.movement.portMax}}</span><span>0</span><span>Starboard {{view.movement.starboardMax}}</span></div>
          </section>

          <section class="ship-helm-axis" aria-label="Rotation" style="--zero-position: 50%;">
            <div class="ship-helm-axis-header">
              <i class="fa-solid fa-rotate" aria-hidden="true"></i>
              <h3>Rotation</h3>
              <span class="ship-helm-budget" data-budget="rotation">Rotation budget: <span class="ship-budget-spent">{{view.movement.rotationBudgetSpentPct}}% spent</span> · <span class="ship-budget-current" data-budget-current>0% current</span> · <span class="ship-budget-left">{{view.movement.rotationBudgetLeftPct}}% left</span></span>
            </div>
            <output class="ship-helm-value-chip" data-slider-value="rotation">0°</output>
            <div class="ship-helm-slider-track" data-helm-track="rotation" style="--zero-position: 50%; {{view.movement.rotationTrackStyle}}">
              <input name="rotation" type="range" value="0" aria-label="Rotation: counterclockwise to clockwise" style="{{view.movement.rotationTrackStyle}}">
            </div>
            <div class="ship-helm-slider-labels"><span>Left {{view.movement.rotationMax}}°</span><span>0</span><span>Right {{view.movement.rotationMax}}°</span></div>
          </section>

          <section class="ship-helm-axis" aria-label="Pivot" style="--zero-position: 50%;">
            <div class="ship-helm-axis-header">
              <i class="fa-solid fa-anchor" aria-hidden="true"></i>
              <h3>Pivot</h3>
              <span class="ship-helm-budget" data-budget="pivot">Pivot budget: <span class="ship-budget-spent">{{view.movement.pivotBudgetSpentPct}}% spent</span> · <span class="ship-budget-current" data-budget-current>0% current</span> · <span class="ship-budget-left">{{view.movement.pivotBudgetLeftPct}}% left</span></span>
            </div>
            <output class="ship-helm-value-chip" data-slider-value="pivot">0°</output>
            <div class="ship-helm-slider-track" data-helm-track="pivot" style="--zero-position: 50%; {{view.movement.pivotTrackStyle}}">
              <input name="pivot" type="range" value="0" aria-label="Pivot: counterclockwise to clockwise" style="{{view.movement.pivotTrackStyle}}">
            </div>
            <div class="ship-helm-slider-labels"><span>Left {{view.movement.pivotMax}}°</span><span>0</span><span>Right {{view.movement.pivotMax}}°</span></div>
          </section>

          <section class="ship-helm-axis" aria-label="Coast" style="--zero-position: 50%;">
            <div class="ship-helm-axis-header">
              <i class="fa-solid fa-hourglass-half" aria-hidden="true"></i>
              <h3>Coast</h3>
              <span class="ship-helm-budget" data-budget="translation">Trans budget: <span class="ship-budget-spent">{{view.movement.translationBudgetSpentPct}}% spent</span> · <span class="ship-budget-current" data-budget-current>0% current</span> · <span class="ship-budget-left">{{view.movement.translationBudgetLeftPct}}% left</span></span>
            </div>
            <output class="ship-helm-value-chip" data-slider-value="coastDuration">0.00 time (0%)</output>
            <div class="ship-helm-slider-track ship-helm-slider-track--coast" data-helm-track="coast" style="{{view.movement.coastTrackStyle}}">
              <input name="coastDuration" type="range" min="0" max="{{view.movement.timelineRemaining}}" step="0.01" value="0" aria-label="Coast duration: zero to remaining timeline" style="{{view.movement.coastTrackStyle}}">
            </div>
            <div class="ship-helm-slider-labels"><span>0.00</span><span>{{view.movement.timelineRemainingHalf}}</span><span>{{view.movement.timelineRemaining}} max</span></div>
          </section>

        </fieldset>

        <div class="ship-helm-sidebar">
          <aside class="ship-vector-panel" aria-label="Ship vector">
            <h3>Ship Vector</h3>
            <div class="ship-vector-compass">
              <span class="ship-vector-label ship-vector-label--f">F</span>
              <span class="ship-vector-label ship-vector-label--r">R</span>
              <span class="ship-vector-label ship-vector-label--a">A</span>
              <span class="ship-vector-label ship-vector-label--l">L</span>
              <div class="ship-vector-image" data-vector-image style="transform: rotate({{view.movement.heading}}deg)">
                <img src="{{actor.img}}" alt="{{actor.name}}">
              </div>
            </div>
            <dl class="ship-vector-readouts">
              <div><dt>Speed</dt><dd data-vector-speed>{{view.movement.speed}}</dd></div>
              <div><dt>Safe Limit</dt><dd>{{view.movement.safeVelocity}}</dd></div>
              <div><dt>Heading</dt><dd data-vector-heading>{{view.movement.headingLabel}}</dd></div>
              <div><dt>Angular Vel</dt><dd data-vector-angvel>{{view.movement.angularVelocity}}</dd></div>
            </dl>
          </aside>

          <div class="ship-helm-result">
            <div class="ship-helm-result-header">
              <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              <div>
                <strong>Projected Result</strong>
                <small class="ship-muted">Result after committing this maneuver.</small>
              </div>
            </div>
            <p class="ship-preview-line" data-preview aria-live="polite"></p>
          </div>

          <div class="ship-helm-actions">
            <button class="ship-primary" type="submit" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-play" aria-hidden="true"></i> <span>Commit maneuver<small>Spend allocated time</small></span></button>
            <button type="button" data-coast-remaining="true" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-rotate-right" aria-hidden="true"></i> <span>Coast remaining<small>Use remaining time</small></span></button>
            <button type="button" data-helm-reset {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-arrow-rotate-left" aria-hidden="true"></i> <span>Reset sliders<small>Clear current inputs</small></span></button>
            {{#if view.movement.evasionArmed}}<button type="button" data-ui-operation="disarmEvasion" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> <span>Disarm evasion<small>Release reserve</small></span></button>{{else}}<button type="button" data-ui-operation="armEvasion" data-tier="standard" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-shield" aria-hidden="true"></i> <span>Arm evasion<small>Reserve timeline</small></span></button>{{#if view.movement.evasionHardAvailable}}<button type="button" data-ui-operation="armEvasion" data-tier="hard" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}><i class="fa-solid fa-shield-heart" aria-hidden="true"></i> <span>Arm hard evasion<small>Larger reserve, higher cap</small></span></button>{{/if}}{{/if}}
          </div>
          <p class="ship-muted"><span class="ship-readout" data-evasion-ceiling title="Current evasion AC bonus / protocol ceiling">Evasion AC {{view.movement.evasionCeiling}}</span> <span data-evasion-reason role="status"></span></p>
        </div>
      </form>
      {{#if view.status.overspeed}}<p class="ship-warning">Overspeed damage risk</p>{{/if}}
    </section>

    <section id="panel-power-defense" class="ship-console-panel" role="tabpanel" aria-label="Power" data-tab-panel="power-defense" {{#unless tabState.power-defense.active}}hidden{{/unless}}>
      <div class="ship-panel-heading ship-panel-heading--power">
        <h2>Power</h2>
        <label class="ship-page-operator">Engineer<select data-page-operator="power" data-default="{{view.defaults.power}}">{{#each view.operators}}<option value="{{id}}">{{label}} · {{remaining}} {{resource}}</option>{{/each}}</select></label>
        <span class="ship-readout {{#if view.power.redlining}}ship-danger{{/if}}">{{view.power.status}}</span>
      </div>
      <div class="ship-systems-layout">
        <form class="ship-card" data-ui-operation="routePower" data-live-preview="routePower">
          <div class="ship-ftl-power">
            <div class="ship-ftl-reactor" aria-label="Reactor Reserve">
              <div class="ship-ftl-reactor-stack" data-reactor-stack role="meter" aria-label="Reactor power reserve" aria-valuemin="0" aria-valuemax="{{view.power.reactor.maximum}}" aria-valuenow="{{view.power.reactor.free}}"></div>
              <div class="ship-ftl-reactor-indicator" title="Reactor reserve: {{view.power.reactor.free}} of {{view.power.reactor.maximum}} available">
                <i class="fa-solid fa-atom" aria-hidden="true"></i>
                <small>REACTOR</small>
              </div>
            </div>

            <div class="ship-ftl-divider" aria-hidden="true"></div>

            <div class="ship-ftl-systems" role="group" aria-label="Subsystem power allocation">
              {{#each view.power.systems}}
                <div class="ship-ftl-system" data-system="{{id}}">
                  <input type="hidden" name="{{id}}" value="{{value}}" data-power-system>
                  <div class="ship-ftl-stack" data-power-blocks="{{id}}" role="group" aria-label="{{label}} power"></div>
                  <button type="button" class="ship-ftl-icon" data-power-icon="{{id}}" aria-label="{{label}}: Left-click increase, Right-click decrease{{#unless ../canAct}} — {{../actReason}}{{/unless}}" title="{{#unless ../canAct}}{{../actReason}}{{else}}{{label}} · Left-click: +1 · Right-click: −1{{/unless}}" {{#unless ../canAct}}disabled{{/unless}}>
                    <i class="{{icon}}" aria-hidden="true"></i>
                  </button>
                  <span class="ship-ftl-system-label">{{shortLabel}}</span>
                </div>
              {{/each}}
            </div>

            <div class="ship-ftl-divider" aria-hidden="true"></div>

            <div class="ship-ftl-readouts" aria-label="System telemetry">
              <div class="ship-ftl-telemetry-cols">
                <div class="ship-ftl-telemetry-col">
                  <span class="ship-kicker">Systems</span>
                  {{#each view.power.systems}}
                    <div class="ship-ftl-readout-row">
                      <span class="ship-ftl-readout-label"><i class="{{icon}}" aria-hidden="true"></i> {{shortLabel}}</span>
                      <output class="ship-ftl-readout-value" data-power-effect="{{id}}">{{effect}}</output>
                    </div>
                  {{/each}}
                </div>

                <div class="ship-ftl-subdivider" aria-hidden="true"></div>

                <div class="ship-ftl-telemetry-col">
                  <span class="ship-kicker">Reactor Grid</span>
                  <div class="ship-ftl-readout-row">
                    <span class="ship-ftl-readout-label"><i class="fa-solid fa-bolt" aria-hidden="true"></i> PWR</span>
                    <output class="ship-ftl-readout-value" data-power-grid="draw">{{view.power.grid.draw}}</output>
                  </div>
                  <div class="ship-ftl-readout-row">
                    <span class="ship-ftl-readout-label"><i class="fa-solid fa-battery-half" aria-hidden="true"></i> FREE</span>
                    <output class="ship-ftl-readout-value" data-power-grid="free">{{view.power.grid.free}}</output>
                  </div>
                  <div class="ship-ftl-readout-row">
                    <span class="ship-ftl-readout-label"><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i> EMIT</span>
                    <output class="ship-ftl-readout-value {{#if view.power.redlining}}ship-danger{{/if}}" data-power-grid="emission">{{view.power.grid.emission}}</output>
                  </div>
                  <div class="ship-ftl-readout-row">
                    <span class="ship-ftl-readout-label"><i class="fa-solid fa-fire" aria-hidden="true"></i> HEAT</span>
                    <output class="ship-ftl-readout-value" data-power-grid="heat">{{view.power.grid.heat}}</output>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="ship-power-footer">
            <details class="ship-power-priorities"><summary>Automatic shedding priorities</summary><p class="ship-muted">First is protected longest; last sheds first.</p><div class="ship-form-grid">{{#each view.power.sheddingPriority}}<label>System {{label}}<select name="sheddingPriority-{{index}}">{{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/each}}</div><p class="ship-muted">Weapon priority uses the same highest-to-lowest order.</p><div class="ship-form-grid">{{#each view.power.weaponPriority}}<label>Weapon {{label}}<select name="weaponPriority-{{index}}">{{#each options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/each}}</div></details>
            <div class="ship-action-row ship-power-actions"><button type="button" data-ui-operation="takeControl" data-control="power" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}>Take power</button><button class="ship-primary" type="submit" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}>Commit and release</button></div>
          </div>
          <p class="ship-preview-line" data-preview aria-live="polite"></p>
        </form>
      </div>
      {{#if view.shields.sectors.length}}
        <form class="ship-shield-hud {{#unless view.shields.directional}}ship-shield-hud--bubble{{/unless}}" data-ui-operation="routeDefense" data-live-preview="routeDefense">
          <div class="ship-shield-hud-grid">
            <p class="ship-shield-total"><span>Total</span><output data-shield-total-hp>{{view.shields.totalHp}}</output><span aria-hidden="true">/</span><output data-shield-total-budget>{{view.shields.budget}}</output></p>
            {{#each view.shields.sectors}}
              <article class="ship-shield-sector-card" data-sector="{{id}}" data-position="{{position}}">
                <header class="ship-shield-sector-head">
                  <i class="fa-solid fa-caret-up" aria-hidden="true"></i>
                  <h3>{{label}}</h3>
                  <span class="ship-shield-head-rule" aria-hidden="true"></span>
                </header>
                <p class="ship-shield-sector-stats">
                  <span>HP <output data-shield-hp="{{id}}">{{hp}}</output></span>
                  <span>ALLOC <output data-shield-alloc-value="{{id}}">{{allocation}}</output></span>
                  <span>MAX <output data-shield-max="{{id}}">{{capacity}}</output></span>
                </p>
                <div class="ship-shield-bar" data-shield-bar="{{id}}" data-hp="{{hp}}" data-alloc="{{allocation}}" data-max="{{capacity}}" role="img" aria-label="{{label}} shield charge: {{hp}} of {{capacity}}"></div>
                <input type="hidden" name="allocation-{{id}}" value="{{allocation}}" min="0" max="{{capacity}}">
                <div class="ship-shield-controls">
                  <div class="ship-shield-control ship-shield-control--charge">
                    <div class="ship-shield-row">
                      <span class="ship-shield-row-label">Charge</span>
                      <button type="button" data-shield-alloc="{{id}}" data-delta="-1" aria-label="Remove one {{label}} shield allocation" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>−</button>
                      <strong class="ship-shield-row-value" data-shield-row-value="{{id}}">{{allocation}} / {{capacity}}</strong>
                      <button type="button" data-shield-alloc="{{id}}" data-delta="+1" aria-label="Add one {{label}} shield allocation" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>+</button>
                    </div>
                  </div>
                  <div class="ship-shield-control-divider" aria-hidden="true"></div>
                  <div class="ship-shield-control ship-shield-control--regen">
                    <div class="ship-shield-row ship-shield-row--regen">
                      <button type="button" data-shield-regen="{{id}}" data-delta="-1" aria-label="Decrease {{label}} regen weight" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>−</button>
                      <div class="ship-shield-regen-middle">
                        <div class="ship-shield-regen-topline">
                          <span class="ship-shield-row-label">Regen</span>
                          <span class="ship-shield-regen-readout"><output data-regen-value="{{id}}">{{weight}}% / {{weightCap}}%</output><span aria-hidden="true">·</span><output data-regen-rate="{{id}}">{{rate}} / round</output></span>
                        </div>
                        <div class="ship-shield-pips" data-shield-regen-pips="{{id}}" role="group" aria-label="{{label}} regeneration weight, one pip per 5 percent"></div>
                      </div>
                      <button type="button" data-shield-regen="{{id}}" data-delta="+1" aria-label="Increase {{label}} regen weight" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>+</button>
                    </div>
                  </div>
                </div>
                <input type="hidden" name="regen-{{id}}" value="{{weight}}">
                <p class="ship-shield-status" data-shield-status="{{id}}" {{#unless statusLabel}}hidden{{/unless}}>{{#if statusLabel}}{{statusLabel}}{{/if}}</p>
              </article>
            {{/each}}
            <div class="ship-shield-center">
              <div class="ship-shield-compass">
                <span class="ship-shield-compass-label ship-shield-compass-label--fore" aria-hidden="true">FORE</span>
                <span class="ship-shield-compass-label ship-shield-compass-label--port" aria-hidden="true">PORT</span>
                <span class="ship-shield-compass-label ship-shield-compass-label--starboard" aria-hidden="true">STARBOARD</span>
                <span class="ship-shield-compass-label ship-shield-compass-label--aft" aria-hidden="true">AFT</span>
                <div class="ship-shield-compass-image"><img src="{{actor.img}}" alt="{{actor.name}}"></div>
              </div>
            </div>
            <aside class="ship-shield-pool" data-pool="charge" aria-label="Unassigned charge" {{#unless view.shields.directional}}hidden{{/unless}}>
              <i class="fa-solid fa-draw-polygon" aria-hidden="true"></i>
              <div class="ship-shield-pool-body">
                <span class="ship-shield-pool-kicker">Unassigned</span>
                <output class="ship-shield-pool-value" data-shield-unassigned>0</output>
              </div>
            </aside>
            <aside class="ship-shield-pool" data-pool="regen" aria-label="Unassigned regen" {{#unless view.shields.directional}}hidden{{/unless}}>
              <i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i>
              <div class="ship-shield-pool-body">
                <span class="ship-shield-pool-kicker">Unassigned</span>
                <output class="ship-shield-pool-value" data-shield-unassigned-regen>{{view.shields.unassignedRegen}}</output>
              </div>
            </aside>
          </div>
          {{#unless view.shields.regeneration}}<p class="ship-muted">0 regeneration at current tier; regeneration policy persists.</p>{{/unless}}
          <p class="ship-preview-line" data-preview aria-live="polite"></p>
          <div class="ship-action-row ship-shield-actions">
            <button type="button" data-distribute="allocation" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}>Balance charge</button>
            <button type="button" data-distribute="regen" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}>Balance regen</button>
            <button type="button" data-ui-operation="takeControl" data-control="defense" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}>Take defense</button>
            <button class="ship-primary" type="submit" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}>Commit and release</button>
          </div>
        </form>
      {{/if}}
    </section>

    <section id="panel-sensors" class="ship-console-panel ship-radar-panel" role="tabpanel" aria-label="Sensors" data-tab-panel="sensors" {{#unless tabState.sensors.active}}hidden{{/unless}}>
      <div class="ship-panel-heading">
        <h2>Sensors</h2>
        <label class="ship-page-operator">Sensor operator<select name="operatorId" data-page-operator="sensors" data-default="{{view.defaults.sensors}}">{{#each view.operators}}<option value="{{id}}">{{label}} · Sensors {{ratings.sensors}} · {{remaining}} {{resource}}</option>{{/each}}</select></label>
        <span class="ship-readout" data-radar-status>{{#if view.radar.online}}ONLINE · {{view.radar.activeRange}} / {{view.radar.passiveRange}} DU · {{view.radar.liveCount}} CONTACTS{{else}}SENSORS OFFLINE{{/if}}</span>
      </div>
      <form class="ship-radar-stage" data-radar-stage data-sensor-form role="group" aria-label="Sensor radar. Selecting a contact focuses it independently of weapon targeting.">
        <input type="hidden" name="targetUuid" value="">
        <canvas class="ship-radar-canvas" data-radar-canvas aria-hidden="true"></canvas>
        <div class="ship-radar-hits" data-radar-hits>
          {{#each view.contacts}}{{#unless unknown}}<button type="button" class="ship-radar-hit{{#if targeted}} is-targeted{{/if}}{{#if stale}} is-stale{{/if}}{{#if hoisted}} is-hoisted{{/if}}" data-sensor-focus="{{targetUuid}}" data-radar-state="{{state}}" aria-pressed="false" aria-label="{{designatorLabel}} · {{distanceLabel}} · bearing {{bearingLabel}} · {{stateLabel}}{{#if jammed}} · interference{{/if}}" style="{{style}}"><span class="ship-radar-hit-label">{{label}}</span></button>{{/unless}}{{/each}}
        </div>
        <aside class="ship-radar-corner ship-radar-corner--locks" aria-label="Targeting and locks">
          <span class="ship-kicker">Targeting &amp; Locks</span>
          <div class="ship-radar-actions">
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="acquire" title=""><i class="fa-solid fa-crosshairs" aria-hidden="true"></i><span class="ship-radar-action-label">Acquire target</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="firingSolution" title=""><i class="fa-solid fa-bullseye" aria-hidden="true"></i><span class="ship-radar-action-label">Firing solution</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="breakLock" title=""><i class="fa-solid fa-link-slash" aria-hidden="true"></i><span class="ship-radar-action-label">Break lock</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
          </div>
        </aside>
        <aside class="ship-radar-corner ship-radar-corner--recon" aria-label="Reconnaissance and intelligence">
          <span class="ship-kicker">Recon &amp; Intelligence</span>
          <div class="ship-radar-actions">
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="ping" title=""><i class="fa-solid fa-satellite-dish" aria-hidden="true"></i><span class="ship-radar-action-label">Active ping</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="analyze" title=""><i class="fa-solid fa-magnifying-glass-chart" aria-hidden="true"></i><span class="ship-radar-action-label">Analyze defenses</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="deepScan" title=""><i class="fa-solid fa-diagram-project" aria-hidden="true"></i><span class="ship-radar-action-label">Deep scan</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
          </div>
        </aside>
        <aside class="ship-radar-corner ship-radar-corner--readout" data-sensor-focus-panel aria-label="Focused contact telemetry" aria-live="polite"><p class="ship-empty">Select a radar contact to inspect it.</p></aside>
        <aside class="ship-radar-corner ship-radar-corner--ew" aria-label="Electronic warfare">
          <span class="ship-kicker">Electronic Warfare</span>
          <div class="ship-radar-actions">
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="jam" title=""><i class="fa-solid fa-tower-broadcast" aria-hidden="true"></i><span class="ship-radar-action-label">Jam</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="burnThrough" title=""><i class="fa-solid fa-bolt" aria-hidden="true"></i><span class="ship-radar-action-label">Burn through</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
            <button type="button" class="ship-radar-action" data-radar-action data-ui-operation="fade" title=""><i class="fa-solid fa-ghost" aria-hidden="true"></i><span class="ship-radar-action-label">Fade track</span><span class="ship-radar-cost" aria-hidden="true">1</span></button>
          </div>
        </aside>
        <div class="ship-radar-zoom" data-radar-zoom role="group" aria-label="Radar display range">
          <button type="button" class="ship-radar-zoom-chip" data-radar-zoom-auto aria-pressed="{{view.radar.auto}}">AUTO</button>
          {{#each view.radar.presets}}<button type="button" class="ship-radar-zoom-chip" data-radar-zoom-preset="{{value}}" aria-pressed="{{active}}">{{label}}</button>{{/each}}
          <span class="ship-radar-zoom-readout" data-radar-zoom-readout>{{view.radar.scaleLabel}}</span>
        </div>
      </form>
    </section>

    <section id="panel-weapons" class="ship-console-panel" role="tabpanel" aria-label="Weapons" data-tab-panel="weapons" {{#unless tabState.weapons.active}}hidden{{/unless}}>
      <div class="ship-panel-heading">
        <h2>Weapons</h2>
        <label class="ship-page-operator">Gunner<select data-page-operator="weapons" data-default="{{view.defaults.gunnery}}">{{#each view.operators}}<option value="{{id}}">{{label}} · Gunnery {{ratings.gunnery}} · {{remaining}} {{resource}}</option>{{/each}}</select></label>
        <span class="ship-readout">{{view.power.weaponReserved}} / {{view.power.allocation.weapons}} POWER</span>
      </div>
      <div class="ship-weapon-layout">
        <div class="ship-weapon-list">
          {{#each view.weapons}}
            <form class="ship-card ship-weapon-card" data-ui-operation="attack" data-live-preview="attack" data-weapon-id="{{id}}" data-status="{{status}}" data-mode="{{mode}}" data-severity="{{fault.severity}}" tabindex="0" aria-label="{{label}} firing envelope">
              <input type="hidden" name="weaponId" value="{{id}}"><input type="hidden" name="targetUuid" value="">
              <div class="ship-weapon-dial-cell">
                <span data-weapon-validity role="status" aria-label="Shot validity not evaluated">—</span>
                <span class="ship-dial{{#if dial.ratio}} ship-dial--optimal{{/if}}" style="{{dial.style}}" data-dial data-dial-max="{{dial.maximumRange}}" title="{{dial.title}}" aria-hidden="true"><span class="ship-dial-marker" data-dial-marker hidden></span></span>
              </div>
              <div class="ship-weapon-head">
                <h3 title="{{hardpoint}}">{{label}}</h3>
                {{#if fault.visible}}<span class="ship-fault-chip ship-fault-chip--{{fault.severity}}" title="{{fault.detail}}">{{fault.label}}</span>{{/if}}
                <span class="ship-ammo" title="Ammunition {{readiness}} of {{capacity}}"><span class="ship-ammo-label">Ammo</span><strong>{{readiness}}/{{capacity}}</strong><span class="ship-meter ship-meter--{{readinessMeter.tone}}" style="{{readinessMeter.style}}"><span></span></span></span>
                <div class="ship-switch" role="group" aria-label="{{label}} power state">
                  <button type="button" class="ship-switch-seg ship-switch-seg--off" data-weapon-setting="off" data-current="{{switch.off.current}}" data-reachable="{{switch.off.reachable}}" {{#unless ../canAct}}disabled{{/unless}} aria-label="Power Off{{#if switch.off.current}} — current state{{/if}}{{#unless ../canAct}} — {{../actReason}}{{/unless}}" title="{{#unless ../canAct}}{{../actReason}}{{else}}{{#if switch.off.reason}}{{switch.off.reason}}{{else}}Shut this weapon down{{/if}}{{/unless}}">Off</button>
                  <button type="button" class="ship-switch-seg ship-switch-seg--on" data-weapon-setting="nominal" data-current="{{switch.nominal.current}}" data-reachable="{{switch.nominal.reachable}}" {{#unless ../canAct}}disabled{{/unless}} aria-label="Power On{{#if switch.nominal.current}} — current state{{/if}}{{#unless ../canAct}} — {{../actReason}}{{/unless}}" title="{{#unless ../canAct}}{{../actReason}}{{else}}{{#if switch.nominal.reason}}{{switch.nominal.reason}}{{else}}Online in Nominal mode{{/if}}{{/unless}}">On{{#if booting}}<span class="ship-switch-count" aria-hidden="true">{{bootCounter}}</span>{{/if}}</button>
                  {{#if switch.overclock}}<button type="button" class="ship-switch-seg ship-switch-seg--oc" data-weapon-setting="overclock" data-current="{{switch.overclock.current}}" data-reachable="{{switch.overclock.reachable}}" {{#unless ../canAct}}disabled{{/unless}} aria-label="Overclock{{#if switch.overclock.current}} — current state{{/if}}{{#unless ../canAct}} — {{../actReason}}{{/unless}}" title="{{#unless ../canAct}}{{../actReason}}{{else}}{{#if switch.overclock.reason}}{{switch.overclock.reason}}{{else}}Online in Overclock mode{{/if}}{{/unless}}">OC</button>{{/if}}
                </div>
                <button class="ship-fire" type="submit" {{#unless ../canAttack}}disabled{{/unless}} aria-label="Fire {{label}}"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i><span class="ship-fire-text">Fire</span></button>
              </div>
              <p class="ship-weapon-sub">{{hardpoint}} · Reserves {{reservation}} Power · Heat {{heat}}{{#if heatPerRound}} / round{{/if}}</p>
              <div class="ship-weapon-stats">
                <span class="ship-weapon-stats-text">ACC {{accuracy}} · AP {{armorPiercing}} · {{damage}}</span>
                {{#if barrage}}<label class="ship-weapon-toggle" data-toggle="barrage" title="Engage a barrage profile"><input type="checkbox" data-barrage-enabled> Barrage</label>{{/if}}
                <label class="ship-weapon-toggle" data-toggle="aim" title="Aim at a revealed component in the struck region"><input type="checkbox" data-aim-enabled> Aim</label>
              </div>
              {{#if barrage}}<div class="ship-weapon-options" data-barrage-options><span class="ship-options-label">Barrage</span>{{#each barrageProfiles}}<label class="ship-barrage-chip{{#unless feasible}} ship-barrage-chip--infeasible{{/unless}}" title="{{#if feasible}}×{{rounds}} · {{penalty}} attack · up to {{hits}} hits{{else}}Needs {{rounds}} rounds loaded{{/if}}"><input type="radio" name="barrageRounds" value="{{rounds}}" {{#if selected}}checked{{/if}}><span>×{{rounds}}</span><small>{{penaltyLabel}} · {{hits}} cap</small></label>{{/each}}</div>{{/if}}
              <div class="ship-weapon-options" data-aim-options><span data-aim-slot></span><span class="ship-options-guidance" data-aim-guidance></span></div>
              {{#if manualReload}}<div class="ship-weapon-reload">{{#if reloadWork}}<span>Reload {{reloadLabel}}</span><button type="button" data-ui-operation="reload" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>Contribute reload Work</button><button type="button" data-ui-operation="cancelReload" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>Cancel reload</button>{{else}}<span class="ship-muted">Manual reload: 1 Work</span><button type="button" data-ui-operation="beginReload" title="{{#unless ../canAct}}{{../actReason}}{{else}}Manual reload: 1 Work{{/unless}}" {{#unless ../canAct}}disabled{{/unless}}>Begin reload</button>{{/if}}</div>{{/if}}
            </form>
          {{else}}<p class="ship-empty">No weapons installed. Open Refit from the maintenance menu to inspect hardpoints.</p>{{/each}}
        </div>
        <aside class="ship-fire-panel" data-fire-panel aria-label="Firing calculation">
          <div class="ship-fire-panel-head">
            <span class="ship-kicker">Fire control</span>
            <p data-target-lamp role="status" aria-live="polite">No Foundry target selected</p>
          </div>
          <div class="ship-fire-panel-body" data-fire-body role="status" aria-live="polite">
            <p class="ship-muted">Hover or click a weapon to see its firing calculation.</p>
          </div>
        </aside>
      </div>
    </section>

    <section id="panel-damage" class="ship-console-panel" role="tabpanel" aria-label="Damage control" data-tab-panel="damage" {{#unless tabState.damage.active}}hidden{{/unless}}>
      <div class="ship-panel-heading">
        <h2>Damage Control</h2>
        <label class="ship-page-operator">Engineer<select data-page-operator="damage" data-default="{{view.defaults.engineering}}">{{#each view.operators}}<option value="{{id}}">{{label}} · Engineering {{ratings.engineering}} · {{remaining}} {{resource}}</option>{{else}}<option value="" disabled selected>Select an operator…</option>{{/each}}</select></label>
        <span class="ship-readout">{{view.status.hull.value}} / {{view.status.hull.maximum}} HULL</span>
      </div>
      <div class="ship-damage-layout">
        <form class="ship-card ship-thermal-card">
          <header><h3>Thermal Management</h3><strong>{{view.status.heat.value}} / {{view.status.heat.maximum}}</strong></header>
          <div class="ship-meter ship-meter--heat" style="{{view.status.heat.style}}"><span></span></div>
          <div class="ship-button-grid">
            <button type="button" data-ui-operation="cooling" {{#unless view.cooling.available}}disabled title="{{view.cooling.unavailableReason}}"{{else}}{{#unless canAct}}disabled title="{{actReason}}"{{/unless}}{{/unless}}><span>Active cooling</span><small>1 Action/Order · removes up to {{view.cooling.output}} Heat</small></button>
            <button type="button" data-ui-operation="vent" {{#unless view.cooling.available}}disabled title="{{view.cooling.unavailableReason}}"{{else}}{{#unless canAct}}disabled title="{{actReason}}"{{/unless}}{{/unless}}><span>Emergency vent</span><small>1 Action/Order · removes {{view.cooling.ventAmount}} Heat · −{{view.cooling.signaturePenalty}} Signature until next Start · cooldown {{view.cooling.ventCooldown}}</small></button>
          </div>
          <p class="ship-muted">Emergency vent: {{view.cooling.ventCooldownLabel}}</p>
        </form>

        <section class="ship-card ship-damage-control-card" aria-label="Damage Control and Repairs">
          <header>
            <div>
              <span class="ship-kicker">Structural Integrity</span>
              <h3>Damage Control &amp; Repairs</h3>
            </div>
            <button type="button" class="ship-slot-action-btn" data-ui-operation="hullRepair" {{#unless canAct}}disabled title="{{actReason}}"{{/unless}}>
              <i class="fa-solid fa-screwdriver-wrench" aria-hidden="true"></i> Field-Patch Hull
            </button>
          </header>
          <p class="ship-action-facts ship-muted">Field-Patch Hull: 1 Order · d20 + Engineering vs DC {{view.hullRepair.dc}} · restores roll − {{view.hullRepair.offset}} Hull · also uses the turn's single Command repair</p>
          <p class="ship-damage-legend ship-muted" title="A fault damages one component; a hazard is an ongoing ship-wide threat.">Fault: one component is damaged. Hazard: an ongoing ship-wide threat, under a hazard clock that counts down to its next escalation. Recovery Work: the crew effort a destroyed component needs before it can be rebuilt.</p>
          <div class="ship-meter ship-meter--{{view.status.hull.tone}}" style="{{view.status.hull.style}}; margin-bottom: 0.5rem;"><span></span></div>

          <section class="ship-condition-list" aria-label="Faults and hazards">
            {{#each view.conditions}}
              <form class="ship-card ship-condition-card ship-condition-card--{{severity}}">
                <header><div><span class="ship-kicker">{{kind}}{{#if sector}} · {{sector}}{{/if}}</span><h3>{{label}}</h3></div><span class="ship-status-chip ship-severity-chip" title="Severity runs minor, then major, then critical, then destroyed; a catastrophic hazard ranks with destroyed.">{{severityLabel}}</span></header>
                {{#if componentLabel}}<p class="ship-muted">{{componentLabel}}</p>{{/if}}{{#if clock}}<p>Hazard clock: <strong>{{clock}}</strong></p>{{/if}}{{#if workLabel}}<p>Recovery Work: <strong>{{workLabel}}</strong></p>{{/if}}
                <input type="hidden" name="conditionId" value="{{id}}"><input type="hidden" name="rating" value="engineering">
                {{#if destroyed}}<p class="ship-action-facts ship-muted">1 Order · +1 toward {{workRequired}} Recovery Work · or all 3 Actions for a Command operator</p><button type="button" data-ui-operation="recoveryWork" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>Contribute Recovery Work</button>{{else}}<p class="ship-action-facts ship-muted">1 Order · d20 + Engineering vs DC {{repairDc}} · reduces one tier, two tiers if beaten by 5 or more</p><button type="button" data-ui-operation="repair" {{#unless ../canAct}}disabled title="{{../actReason}}"{{/unless}}>Attempt repair</button>{{/if}}
              </form>
            {{else}}<div class="ship-card ship-empty"><i class="fa-solid fa-circle-check" aria-hidden="true"></i><strong>No active faults or hazards</strong></div>{{/each}}
          </section>
        </section>
      </div>
    </section>

    <section id="panel-refit" class="ship-console-panel ship-refit-layout" role="tabpanel" aria-label="Refit" data-tab-panel="refit" {{#unless tabState.refit.active}}hidden{{/unless}}>
      <div class="ship-panel-heading"><h2>Refit</h2><span class="ship-readout">{{view.combat.label}}</span></div>
      {{#if refitDenial}}<p class="ship-console-notice ship-refit-denial" data-refit-denial role="status"><i class="fa-solid fa-lock" aria-hidden="true"></i> {{refitDenial}}</p>{{else}}<p class="ship-muted">Browse components for an empty mount or drop compatible component Items onto mounts. Drop onto an occupied row to replace its Item with a fresh embedded copy.</p>{{/if}}
      <section aria-labelledby="refit-slot-heading">
        <h3 id="refit-slot-heading">Component slots</h3>
        <div class="ship-refit-grid">
          {{#each refitSlots}}
            <article class="ship-refit-card {{#unless installed}}ship-refit-card--empty{{/unless}}" data-refit-drop data-mount-id="{{id}}" {{#unless ../canRefit}}data-refit-disabled{{/unless}} aria-label="{{label}} · {{status}}">
              <header><div><span class="ship-kicker">{{role}}</span><h3>{{label}}</h3></div><span>{{size}}</span><span class="ship-status-chip">{{status}}</span></header>
              {{#if installed}}<button type="button" class="ship-refit-installed" data-refit-item="{{itemId}}" aria-label="Open {{itemName}} component Item">{{#if itemImg}}<img src="{{itemImg}}" alt="">{{/if}}<strong>{{itemName}}</strong><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button>{{else}}<div class="ship-refit-drop"><i class="fa-solid fa-download" aria-hidden="true"></i><span>Empty · {{dropLabel}}</span></div>{{/if}}
              {{#unless installed}}<button type="button" data-refit-browse="{{id}}" aria-label="Browse components for {{label}}" {{#unless ../canRefit}}disabled{{/unless}}>Browse components</button>{{/unless}}
              <details><summary>Mount details</summary><dl class="ship-refit-meta"><div><dt>Exact size</dt><dd>{{size}}</dd></div><div><dt>Regions</dt><dd>{{regions}}</dd></div><div><dt>Orientation</dt><dd>{{orientation}}</dd></div></dl>{{#if installed}}<button type="button" data-refit-remove="{{id}}" {{#unless ../canRefit}}disabled{{/unless}}>Remove component</button>{{/if}}</details>
            </article>
          {{else}}<p class="ship-empty">This hull defines no component slots.</p>{{/each}}
        </div>
      </section>
      <section aria-labelledby="refit-hardpoint-heading">
        <h3 id="refit-hardpoint-heading">Hardpoints</h3>
        <div class="ship-refit-grid">
          {{#each refitHardpoints}}
            <article class="ship-refit-card {{#unless installed}}ship-refit-card--empty{{/unless}}" data-refit-drop data-mount-id="{{id}}" {{#unless ../canRefit}}data-refit-disabled{{/unless}} aria-label="{{label}} · {{status}}">
              <header><div><span class="ship-kicker">{{role}}</span><h3>{{label}}</h3></div><span>{{size}}</span><span class="ship-status-chip">{{status}}</span></header>
              {{#if installed}}<button type="button" class="ship-refit-installed" data-refit-item="{{itemId}}" aria-label="Open {{itemName}} weapon Item">{{#if itemImg}}<img src="{{itemImg}}" alt="">{{/if}}<strong>{{itemName}}</strong><i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></button>{{else}}<div class="ship-refit-drop"><i class="fa-solid fa-download" aria-hidden="true"></i><span>Empty · {{dropLabel}}</span></div>{{/if}}
              {{#unless installed}}<button type="button" data-refit-browse="{{id}}" aria-label="Browse components for {{label}}" {{#unless ../canRefit}}disabled{{/unless}}>Browse components</button>{{/unless}}
              <details><summary>Mount details</summary><dl class="ship-refit-meta"><div><dt>Exact size</dt><dd>{{size}}</dd></div><div><dt>Regions</dt><dd>{{regions}}</dd></div><div><dt>Orientation</dt><dd>{{orientation}}</dd></div><div><dt>Traverse</dt><dd>{{traverse}}</dd></div></dl>{{#if installed}}<button type="button" data-refit-remove="{{id}}" {{#unless ../canRefit}}disabled{{/unless}}>Remove weapon</button>{{/if}}</details>
            </article>
          {{else}}<p class="ship-empty">This hull defines no hardpoints.</p>{{/each}}
        </div>
      </section>
      <details class="ship-card">
        <summary>Unreferenced component Items</summary>
        <p class="ship-muted">Advanced hull edits retain Items no longer referenced by a mount. These Items provide no ship capability while unreferenced.</p>
        <div class="ship-refit-grid">{{#each refitUnreferencedItems}}<article class="ship-refit-card"><header><h3>{{name}}</h3><span class="ship-status-chip">Unreferenced</span></header><span>{{componentClass}} · {{size}}</span><button type="button" data-refit-item="{{id}}" aria-label="Open structured Item sheet for {{name}}">Open Item</button></article>{{else}}<p class="ship-empty">No unreferenced component Items.</p>{{/each}}</div>
      </details>
      <details class="ship-card ship-console-config">
        <summary>Advanced hull JSON</summary>
        <p class="ship-muted">Hull structure only. Installed component definitions live in embedded Items. Removing a mount reference retains its Item above; it does not delete the Item.</p>
        <p class="ship-warning" data-hull-stale role="status" {{#unless hullDraftStale}}hidden{{/unless}}>Hull changed since you started editing. <button type="button" data-hull-reload>Reload current hull</button></p>
        <form data-config data-revision="{{configRevision}}"><fieldset {{#unless canRefit}}disabled{{/unless}}><label>Validated hull configuration JSON<textarea name="config" rows="20" spellcheck="false">{{configJson}}</textarea></label><div class="ship-action-row"><button type="submit">Validate and save hull</button><label>Reference build<select name="reference-build" data-reference-build>{{#each referenceBuilds}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><button type="button" data-reference-reset>Reset hull and components…</button></div></fieldset></form>
      </details>
    </section>

    <section id="panel-log-config" class="ship-console-panel" role="tabpanel" aria-label="Log and diagnostics" data-tab-panel="log-config" {{#unless tabState.log-config.active}}hidden{{/unless}}>
      <div class="ship-panel-heading"><h2>Log &amp; Diagnostics</h2></div>
      {{#if isGM}}
        <details class="ship-card ship-diagnostics"><summary>Raw operation console</summary><p class="ship-muted">Diagnostic escape hatch. Normal play uses combat controls.</p><div class="ship-console-actions">{{#each rawActions}}<form class="ship-operation" data-raw-operation="{{type}}"><fieldset {{#if disabled}}disabled{{/if}}><legend>{{group}} · {{type}}</legend>{{#if targeted}}<label>Target Token UUID(s)<input name="targets" type="text" placeholder="Scene.…Token.…"></label>{{/if}}<label>Payload JSON<textarea name="payload" rows="4" spellcheck="false">{}</textarea></label><p class="ship-console-help">{{help}}</p><details><summary>Raw preview</summary><pre data-preview aria-live="polite"></pre></details><button type="submit">Commit {{type}}</button>{{#if reason}}<p class="ship-console-reason">{{reason}}</p>{{/if}}</fieldset></form>{{/each}}</div></details>
        <details class="ship-card ship-diagnostics"><summary>Raw ship state</summary><pre class="ship-console-state">{{stateJson}}</pre></details>
      {{else}}<p class="ship-empty">Diagnostics are available only to the GM.</p>{{/if}}
    </section>
  </div>
</section>
